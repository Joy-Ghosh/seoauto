{
  "name": "local-seo-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:ml && tsx server/index.ts",
    "build": "npm run prepare:ml && tsc --noEmit && vite build && tsx scripts/build-assets.ts",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "setup:hosted": "tsx scripts/setup-hosted.ts",
    "dev:hosted": "tsx --env-file=.env.local server/hosted-dev.ts",
    "prepare:ml": "tsx scripts/prepare-ml.ts"
  },
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "htmlparser2": "^10.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.3",
    "php-parser": "^3.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
