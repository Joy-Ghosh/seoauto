# Server-only. Generate with npm run setup:hosted; never commit .env.local.
APP_SECRET=
APP_PASSWORD_HASH=
# Enables the hosted adapter locally; Vercel always uses it.
HOSTED_MODE=1
PORT=4318
# Optional read-only Search Console connection. CSV import needs no credentials.
# Register /api/search-console/callback on each app origin in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
